{
  "name": "nutri-pessoal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node -e \"const f='dist-single/index.html',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/\\\\uFFFD/g,'\\\\\\\\uFFFD'))\"",
    "preview": "vite preview",
    "test": "esbuild scripts/check.ts --bundle --platform=node --log-level=error --outfile=node_modules/.tmp-check.cjs && node node_modules/.tmp-check.cjs",
    "taco": "node scripts/build-taco.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
